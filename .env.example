# python setup_testnet.py fills in the Oryne and Stellar values.
ORYNE_API_URL=https://testnet-apiv1.oryne.org
CAREERKIT_ADDRESS=
CAREERKIT_SECRET=
DEMO_OWNER_SECRET=
DEMO_WALLET=

# Where this server is reached. Agents pay CareerKit at PUBLIC_URL/careerkit.
PUBLIC_URL=http://localhost:8800

# The model: any OpenAI-compatible API with tool calling. DeepSeek by default.
# Without a key the agent follows a fixed plan and CareerKit uses templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Limits for the public demo.
MAX_CONCURRENT_RUNS=4
RUNS_PER_IP_PER_HOUR=6
